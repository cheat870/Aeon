# Flask
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Bakong / KHQR
# Paste your Bakong or ABA merchant KHQR payload string here (it usually starts with 000201...)
# Example:
# BAKONG_KHQR_BASE=000201010211....6304ABCD
BAKONG_KHQR_BASE=

# Optional: enable automatic payment confirmation by checking Bakong's
# "check_transaction_by_md5" API with a Bearer token.
BAKONG_API_TOKEN=

# Optional: enable ABA PayWay webhook auto-confirm.
# Put a random secret here, then give ABA/PayWay this full webhook URL:
# https://your-domain/api/payments/aba/webhook/<ABA_WEBHOOK_TOKEN>
ABA_WEBHOOK_TOKEN=

# Admin payment confirmation
PAYMENT_CONFIRM_SECRET=change-me

# JWT
JWT_ACCESS_TOKEN_EXPIRES_DAYS=7

# Email verification for register (8-digit code)
# Recommended on Render Free: use Resend over HTTPS
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Use a verified sender like noreply@yourdomain.com.
# For quick testing with your own Resend account email only, you can use onboarding@resend.dev.
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=KOK-eMall
RESEND_REPLY_TO=

# Optional SMTP fallback (works locally; Render Free blocks SMTP ports 25/465/587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=KOK-eMall
SMTP_USE_TLS=1
SMTP_USE_SSL=0

# Telegram polling inside the web app process
RUN_TELEGRAM_BOT_IN_WEB=0

# Telegram bot (admin + auth notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
